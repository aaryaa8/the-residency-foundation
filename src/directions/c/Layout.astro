---
// Direction C, "gilded": the page shell. Head, guide lines, nav, footer, draft marker.
import BaseHead from '../../base/BaseHead.astro';
import DraftMarker from '../../base/DraftMarker.astro';
import Nav from './Nav.astro';
import Footer from './Footer.astro';
import { ui } from '../../content/site';
import './c.css';

interface Props { title?: string; description?: string; current?: string }
const { title, description, current } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={title} description={description} />
    <script is:inline>
      // Motion is switched on only when a script runs and the reader has not asked for less motion.
      // If the main script never reports in, the class is removed so nothing stays hidden.
      (function () {
        var d = document.documentElement;
        d.classList.add('js');
        var calm = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        if (!calm && 'IntersectionObserver' in window) {
          d.classList.add('arrive');
          setTimeout(function () { if (!window.__arrived) d.classList.remove('arrive'); }, 3000);
        }
      })();
    </script>
  </head>
  <body>
    <a class="skip" href="#main">{ui.skip}</a>
    <div class="page">
      <div class="guides" aria-hidden="true"><i></i><i></i><i></i><i></i><i></i><i></i></div>
      <Nav current={current} />
      <main id="main" tabindex="-1">
        <slot />
      </main>
    </div>
    <Footer />
    <DraftMarker />
    <script>
      import './arrive.ts';
    </script>
  </body>
</html>
