---
// A placeholder statue. The image has a white ground, so it is multiplied onto the page:
// the guide lines and arcs behind it stay visible. It stands on the bottom edge of its frame.
import { asset } from '../../base/url';

const about: Record<string, { alt: string }> = {
  sf2: { alt: 'Placeholder image: a marble bust in a graduation cap, holding a scroll.' },
  arcadia: { alt: 'Placeholder image: a bronze statue of a seated figure reading a book.' },
  biopunk: { alt: 'Placeholder image: a jade statue of a figure looking into a microscope.' },
  inventors: { alt: 'Placeholder image: a yellow bust of a figure wearing goggles.' },
  atlas: { alt: 'Placeholder image: a blue statue of Atlas holding up an atom.' },
  odyssey: { alt: 'Placeholder image: a purple statue of a helmeted figure, seen from behind.' },
  vienna: { alt: 'Placeholder image: a terracotta bust of a figure wearing headphones.' },
};

interface Props { name: keyof typeof about; class?: string; eager?: boolean; flip?: boolean }
const { name, class: cls, eager = false, flip = false } = Astro.props;
---
<figure class:list={['statue', `statue--${name}`, flip && 'statue--flip', cls]} data-statue>
  <img
    src={asset(`img/placeholder/${name}.webp`)}
    alt={about[name].alt}
    width="1600"
    height="1600"
    data-placeholder="true"
    loading={eager ? 'eager' : 'lazy'}
    fetchpriority={eager ? 'high' : undefined}
    decoding="async"
  />
</figure>
