---
// Collapsed question rows.
interface Item { id: string; q: string; a: string[] }
interface Props { items: Item[]; level?: 'h3' | 'h4' }
const { items, level = 'h3' } = Astro.props;
const H = level;
---
<div class="faq">
  {items.map((item) => (
    <details class="faq__row" id={`q-${item.id}`}>
      <summary>
        <H class="faq__q">{item.q}</H>
        <span class="faq__icon" aria-hidden="true"></span>
      </summary>
      <div class="faq__a">
        {item.a.map((p) => <p>{p}</p>)}
      </div>
    </details>
  ))}
</div>
