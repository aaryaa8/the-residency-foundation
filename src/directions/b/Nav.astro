---
// The nav is the ledger's header row: logo in columns 1 to 2, one mono label
// per column after that. It gains a hairline box once the page scrolls and
// switches to ivory while it passes over a near-black area.
import Icon from '../../base/Icon.astro';
import { asset, page } from '../../base/url';
import { nav, ui } from '../../content/site';
interface Props { current?: string }
const { current = '' } = Astro.props;
---
<header class="nav" data-nav>
  <nav class="nav__bar" aria-label={ui.menu}>
    <a class="nav__logo" href={page('b')} aria-label={ui.home}>
      <img class="on-light" src={asset('img/logo/foundation-ink.png')} alt="" width="1868" height="642" />
      <img class="on-dark" src={asset('img/logo/foundation-white.png')} alt="" width="1868" height="642" />
    </a>
    <ul class="nav__links" id="nav-links">
      {nav.links.map((l) => (
        <li><a href={page('b', l.slug)} aria-current={current === l.slug ? 'page' : undefined}><Icon name="marker" /><span>{l.label}</span></a></li>
      ))}
    </ul>
    <a class="cta nav__cta" href={page('b', nav.cta.slug)} aria-current={current === nav.cta.slug ? 'page' : undefined}>{nav.cta.label}<Icon name="play" /></a>
    <button class="nav__menu" type="button" aria-expanded="false" aria-controls="nav-links" aria-label={ui.menu} data-menu data-open={ui.menu} data-close={ui.close}><i></i><i></i></button>
  </nav>
</header>
