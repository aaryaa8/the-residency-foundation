---
// A section of the ledger: a strong rule that draws in, the mono label in
// column 1 (it stays in view while the section is read), content in columns 2 to 6.
// The "wide" slot spans all 6 columns under the main block.
import Icon from '../../base/Icon.astro';
import Guides from './Guides.astro';
interface Props { label?: string; id?: string; tone?: 'dark'; class?: string; labelTag?: 'p' | 'h2' }
const { label, id, tone, class: cls, labelTag = 'p' } = Astro.props;
const Tag = labelTag;
---
<section class:list={['sec', cls]} id={id} data-tone={tone}>
  {tone === 'dark' && <Guides />}
  <slot name="back" />
  <div class="sec__in">
    <span class="rule rule--strong" data-draw></span>
    <div class="sec__main">
      <div class="sec__label">
        {label && <Tag class="label" data-reveal><Icon name="marker" />{label}</Tag>}
      </div>
      <div class="sec__body"><slot /></div>
    </div>
    <slot name="wide" />
  </div>
</section>
