---
// The top of a page: a strong rule, the h1 on the left across columns 1 to 4,
// a framed statue on the right in columns 5 to 6, then a hairline and the
// supporting text (default slot: .hero__sub, .hero__body, .hero__ctas).
import Icon from '../../base/Icon.astro';
import H1 from './H1.astro';
import Plate from './Plate.astro';
interface Props {
  heading: string;
  label?: string;
  size?: '' | 'l' | 'm';
  home?: boolean;
  wide?: boolean;
  arc?: boolean;
  plate?: { name: string; alt: string; ratio?: string; pos?: string };
}
const { heading, label, size = '', home = false, wide = false, arc = false, plate } = Astro.props;
---
<section class:list={['hero', home && 'hero--home', wide && 'hero--wide']}>
  <div class="wrap">
    {arc && <div class="hero__clip" aria-hidden="true"><div class="arc hero__arc"></div></div>}
    <span class="rule rule--strong" data-draw></span>
    <div class="hero__grid">
      {label && <p class="label hero__label" data-reveal><Icon name="marker" />{label}</p>}
      <div class="hero__h"><H1 text={heading} class={size ? `h1--${size}` : undefined} /></div>
      <span class="rule hero__rule" data-draw style="--i:3"></span>
      <slot />
      {plate && <Plate class="hero__plate" eager arc={arc} {...plate} />}
    </div>
  </div>
</section>
