---
// Direction B, "ledger": the page shell.
import BaseHead from '../../base/BaseHead.astro';
import DraftMarker from '../../base/DraftMarker.astro';
import Nav from './Nav.astro';
import Footer from './Footer.astro';
import Guides from './Guides.astro';
import { ui } from '../../content/site';
import './ledger.css';
interface Props { title?: string; current?: string }
const { title, current } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={title} />
    <script is:inline>
      // "js" turns the phone menu into a button; "anim" lets lines start hidden so they can draw in.
      // Both are taken away again if the main script has not started, so nothing stays hidden.
      (function () {
        var d = document.documentElement;
        d.classList.add('js');
        var calm = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        if (!calm && 'IntersectionObserver' in window) d.classList.add('anim');
        setTimeout(function () { if (!window.__ledger) d.classList.remove('js', 'anim'); }, 3500);
      })();
    </script>
  </head>
  <body>
    <a class="skip" href="#main">{ui.skip}</a>
    <Nav current={current} />
    <main id="main">
      <Guides page />
      <slot />
    </main>
    <Footer />
    <DraftMarker />
    <script>
      import './ledger.js';
    </script>
  </body>
</html>
