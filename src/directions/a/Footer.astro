---
// White footer, divided by hairlines like the rest of the page.
import Cta from './Cta.astro';
import { asset, page } from '../../base/url';
import { footer, org, ui } from '../../content/site';
import { nb, email } from './text';
---
<footer class="foot">
  <div class="wrap g6 foot__top">
    <a class="foot__logo" href={page('a')} aria-label={ui.home}>
      <img src={asset('img/logo/foundation-ink.png')} alt={org.name} width="1868" height="642" loading="lazy" />
    </a>
    <div class="foot__updates updates">
      <h2 class="label" id="updates-label">{footer.updates.label}</h2>
      <p class="updates__text">{footer.updates.text}</p>
      <form data-form="updates" data-thanks={ui.updatesThanks} aria-labelledby="updates-label">
        <div class="updates__row">
          <label class="visually-hidden" for="updates-email">{footer.updates.placeholder}</label>
          <input id="updates-email" name="email" type="email" required autocomplete="email" placeholder={footer.updates.placeholder} />
          <Cta label={footer.updates.submit} type="submit" />
        </div>
        <label class="check"><input type="checkbox" name="consent" required /><span>{footer.updates.consent}</span></label>
      </form>
    </div>
    <div class="foot__contact">
      <h2 class="label">{footer.contactLabel}</h2>
      <ul>
        {footer.emails.map((e) => <li><a href={`mailto:${e}`}><span set:html={email(e)} /></a></li>)}
      </ul>
    </div>
  </div>
  <div class="wrap g6 foot__legal">
    <div class="foot__legal-text small">
      <p set:html={nb(footer.disclosure)} />
      <p set:html={nb(footer.separate)} />
    </div>
  </div>
  <div class="wrap g6 foot__base">
    <p class="label foot__copy">{footer.copyright}</p>
    <ul class="foot__nav">
      {footer.links.map((l) => <li><a href={page('a', l.slug)}><span>{l.label}</span></a></li>)}
    </ul>
  </div>
</footer>
