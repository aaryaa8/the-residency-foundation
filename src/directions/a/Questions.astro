---
// Collapsed question rows.
interface Item { id: string; q: string; a: string[] }
interface Props { items: Item[]; level?: 'h3' | 'h4' }
const { items } = Astro.props;
---
{items.map((item, i) => (
  <details class="qa" id={`q-${item.id}`} data-rise style={`--d:${Math.min(i, 6) * 50}ms`}>
    <summary><h3 class="qa__q">{item.q}</h3><span class="qa__icon" aria-hidden="true"></span></summary>
    <div class="qa__a">{item.a.map((p) => <p>{p}</p>)}</div>
  </details>
))}
