---
// Fixed nav: transparent with a hairline at the top of the page, a thin
// bordered box once the page has scrolled. On phones the links fold behind a
// menu button (and stay visible in a row if scripting is off).
import Cta from './Cta.astro';
import { asset, page } from '../../base/url';
import { nav, org, ui } from '../../content/site';
interface Props { current?: string }
const { current = '' } = Astro.props;
---
<header class="nav" data-nav>
  <div class="nav__box">
    <a class="nav__logo" href={page('a')} aria-label={ui.home}>
      <img src={asset('img/logo/foundation-ink.png')} alt={org.name} width="1868" height="642" />
    </a>
    <nav class="nav__links" id="nav-links">
      <ul>
        {nav.links.map((l) => (
          <li><a href={page('a', l.slug)} aria-current={current === l.slug ? 'page' : undefined}><span>{l.label}</span></a></li>
        ))}
      </ul>
    </nav>
    <div class="nav__end">
      <Cta href={page('a', nav.cta.slug)} label={nav.cta.label} />
      <button class="nav__toggle" type="button" aria-expanded="false" aria-controls="nav-links"
        aria-label={ui.menu} data-open-label={ui.menu} data-close-label={ui.close}><i></i><i></i></button>
    </div>
  </div>
</header>
