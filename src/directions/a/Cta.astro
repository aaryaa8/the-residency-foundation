---
// A call to action: mono text followed by the play circle. Never a filled button.
import Icon from '../../base/Icon.astro';
import { ui } from '../../content/site';
interface Props { href?: string; label: string; size?: 'md' | 'lg' | 'bar'; external?: boolean; type?: 'submit' | 'button'; class?: string }
const { href, label, size = 'md', external = false, type, class: cls } = Astro.props;
const icon = size === 'bar' ? 28 : size === 'lg' ? 22 : 16;
---
{href ? (
  <a class:list={['cta', size === 'lg' && 'cta--lg', size === 'bar' && 'cta--bar', cls]} href={href} {...(external ? { target: '_blank', rel: 'noopener' } : {})}>
    <span>{label}</span>{external && <span class="visually-hidden"> ({ui.newTab})</span>}<Icon name="play" size={icon} />
  </a>
) : (
  <button class:list={['cta', size === 'lg' && 'cta--lg', size === 'bar' && 'cta--bar', cls]} type={type ?? 'button'}>
    <span>{label}</span><Icon name="play" size={icon} />
  </button>
)}
