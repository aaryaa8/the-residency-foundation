---
// A section: a hairline, a mono label hanging in the first column, and the
// content in the middle four columns. When there is no heading, the label is
// the section's h2.
interface Props { label: string; heading?: string; class?: string; id?: string }
const { label, heading, class: cls, id } = Astro.props;
---
<section class:list={['sec', cls]} id={id}>
  <div class="wrap g6 sec__grid">
    {heading ? <p class="label sec__label" data-rise>{label}</p> : <h2 class="label sec__label" data-rise>{label}</h2>}
    <div class="sec__body">
      {heading && <h2 class="h2" data-rise>{heading}</h2>}
      <slot />
    </div>
    <slot name="after" />
  </div>
</section>
