---
// Small fixed label shown on every page until the site is approved for release.
import { org } from '../content/site';
---
<div class="draft-marker" role="note">{org.draftLabel}</div>
<style>
  .draft-marker { position: fixed; left: 12px; bottom: 12px; z-index: 50; padding: 6px 10px; background: var(--ink); color: var(--ivory); border: 1px solid rgba(250, 249, 232, 0.45); font-family: var(--mono); font-size: 10px; font-weight: 700; letter-spacing: 0.06em; text-transform: uppercase; pointer-events: none; }
</style>
