---
// Shared icons, taken from the live Residency site. They inherit the text colour.
// <Icon name="play" /> the call-to-action circle | "marker" the 8px corner marker | "sparkle" list bullet
interface Props { name: 'play' | 'marker' | 'sparkle' | 'corner'; size?: number; class?: string }
const { name, size, class: cls } = Astro.props;
const s = size ?? (name === 'play' || name === 'sparkle' ? 16 : 8);
---
{name === 'play' && (
  <svg class={cls} width={s} height={s} viewBox="0 0 16 16" aria-hidden="true" fill="currentColor"><path d="M 8 0 C 12.418 0 16 3.582 16 8 C 16 12.418 12.418 16 8 16 C 3.582 16 0 12.418 0 8 C 0 3.582 3.582 0 8 0 Z M 6.997 4 C 6.883 4 6.784 4.076 6.754 4.186 L 6.754 11.815 C 6.782 11.926 6.882 12.004 6.997 12.004 C 7.111 12.004 7.211 11.926 7.239 11.815 C 7.71 10.074 9.071 8.713 10.812 8.242 C 10.922 8.213 11 8.114 11 8 C 10.999 7.886 10.922 7.788 10.812 7.758 C 9.071 7.287 7.711 5.927 7.239 4.186 C 7.21 4.076 7.111 4 6.997 4 Z" fill-rule="evenodd"/></svg>
)}
{name === 'marker' && (
  <svg class={cls} width={s} height={s} viewBox="0 0 8 8" aria-hidden="true" fill="currentColor"><path transform="translate(1 1)" d="M 0.076 0.077 C -0.007 0.16 -0.024 0.289 0.035 0.39 C 0.963 2.007 0.963 3.993 0.035 5.61 C -0.024 5.713 -0.006 5.843 0.074 5.925 C 0.158 6.008 0.288 6.024 0.389 5.964 C 2.006 5.037 3.994 5.037 5.611 5.964 C 5.714 6.023 5.839 6.005 5.923 5.923 C 6.006 5.84 6.023 5.711 5.964 5.61 C 5.037 3.993 5.037 2.007 5.964 0.39 C 6.023 0.289 6.008 0.16 5.926 0.075 C 5.842 -0.008 5.713 -0.024 5.611 0.036 C 3.994 0.963 2.006 0.963 0.389 0.036 C 0.288 -0.022 0.159 -0.005 0.076 0.077 Z"/></svg>
)}
{name === 'sparkle' && (
  <svg class={cls} width={s} height={s} viewBox="0 0 8 8" aria-hidden="true" fill="currentColor"><path transform="translate(1 1)" d="M 3 0 C 2.915 -0.001 2.84 0.057 2.818 0.139 C 2.465 1.445 1.446 2.465 0.141 2.819 C 0.059 2.841 0.001 2.915 0 3 C 0.001 3.085 0.058 3.16 0.141 3.182 C 1.446 3.536 2.465 4.556 2.818 5.862 C 2.84 5.944 2.915 6.001 3 6 C 3.085 6.001 3.16 5.943 3.182 5.861 C 3.535 4.555 4.554 3.535 5.859 3.181 C 5.941 3.159 5.999 3.085 6 3 C 6 2.914 5.942 2.84 5.859 2.818 C 4.554 2.464 3.535 1.444 3.182 0.138 C 3.159 0.056 3.085 0 3 0 Z"/></svg>
)}
{name === 'corner' && (
  <svg class={cls} width={s} height={s} viewBox="0 0 8 8" aria-hidden="true" fill="currentColor"><path d="M 8 8 L 0 8 L 0 0 L 1 0 C 1 4.086 3.914 7 8 7 Z"/></svg>
)}
