---
// Shared <head>. Every page of every direction includes this first.
// It loads the fonts and tokens, keeps the draft out of search engines, and sets the favicon.
import '@fontsource/geist-mono/500.css';
import '@fontsource/geist-mono/700.css';
import './tokens.css';
import { asset } from './url';
import { org } from '../content/site';

interface Props { title?: string; description?: string }
const { title, description = org.description } = Astro.props;
const fullTitle = title ? `${title} | ${org.name}` : org.name;
---
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
{/* Draft for internal review: keep out of search engines until the site is approved for release. */}
<meta name="robots" content="noindex, nofollow" />
<title>{fullTitle}</title>
<meta name="description" content={description} />
<link rel="icon" type="image/png" href={asset('favicon.png')} />
<link rel="preconnect" href="https://framerusercontent.com" crossorigin />
