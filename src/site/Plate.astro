---
// A placeholder statue in a hairline frame, with the 4 corner markers just
// outside its corners. The frame sits on grid lines and the statue stands on
// its bottom edge. The image is seen through a doorway: with door="load" it
// opens on page load, with "scroll" when it comes into view, with "still" never.
import Icon from '../base/Icon.astro';
import { asset } from '../base/url';
import { placeholders } from '../content/site';
interface Props { name: string; ratio?: string; pos?: string; class?: string; door?: 'load' | 'scroll' | 'still'; arc?: boolean }
const { name, ratio = '4 / 5', pos = '50% 100%', class: cls, door = 'scroll', arc = false } = Astro.props;
const eager = door === 'load';
---
<figure class:list={['plate', arc && 'plate--arc', cls]} data-door={door} style={`--ratio:${ratio};--pos:${pos}`}>
  {arc && <div class="plate__bg" aria-hidden="true"><div class="arc plate__arc"></div></div>}
  <span class="door__view">
    <img src={asset(`img/placeholder/${name}-mono.webp`)} alt={placeholders[name]} width="1600" height="1600" data-placeholder="true"
      loading={eager ? 'eager' : 'lazy'} decoding="async" fetchpriority={eager ? 'high' : undefined} />
  </span>
  <span class="door__jamb door__jamb--l"></span><span class="door__jamb door__jamb--r"></span>
  <span class="plate__f plate__f--t"></span><span class="plate__f plate__f--r"></span><span class="plate__f plate__f--b"></span><span class="plate__f plate__f--l"></span>
  <Icon name="marker" class="plate__m plate__m--tl" /><Icon name="marker" class="plate__m plate__m--tr" /><Icon name="marker" class="plate__m plate__m--br" /><Icon name="marker" class="plate__m plate__m--bl" />
</figure>
