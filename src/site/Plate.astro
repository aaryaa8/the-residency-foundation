---
// A placeholder statue in a hairline frame, with the 4 corner markers beside
// its corners. The frame sits on grid lines and the statue stands on its bottom
// edge. The image is seen through a doorway: with door="load" it opens on page
// load, with "scroll" when it comes into view. `fill` lets the statue fill a
// frame whose height is set by the text beside it.
import Icon from '../base/Icon.astro';
import { asset } from '../base/url';
import { placeholders } from '../content/site';
interface Props { name: string; ratio?: string; stacked?: string; pos?: string; class?: string; door?: 'load' | 'scroll'; fill?: boolean }
// `stacked` is the frame's shape on tablets and phones, where it is sized to the statue.
const { name, ratio = '4 / 5', stacked = '1 / 1', pos = '50% 100%', class: cls, door = 'scroll', fill = false } = Astro.props;
const eager = door === 'load';
---
<figure class:list={['plate', fill && 'plate--fill', cls]} data-door={door} style={`--ratio:${ratio};--ratio-stacked:${stacked};--pos:${pos}`}>
  <span class="door__view">
    <img src={asset(`img/placeholder/${name}-mono.webp`)} alt={placeholders[name]} width="1600" height="1600" data-placeholder="true"
      loading={eager ? 'eager' : 'lazy'} decoding="async" fetchpriority={eager ? 'high' : undefined} />
  </span>
  <span class="door__jamb door__jamb--l"></span><span class="door__jamb door__jamb--r"></span>
  <span class="plate__f plate__f--t"></span><span class="plate__f plate__f--r"></span><span class="plate__f plate__f--b"></span><span class="plate__f plate__f--l"></span>
  <Icon name="marker" class="plate__m plate__m--tl" /><Icon name="marker" class="plate__m plate__m--tr" /><Icon name="marker" class="plate__m plate__m--br" /><Icon name="marker" class="plate__m plate__m--bl" />
</figure>
