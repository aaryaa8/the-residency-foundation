---
import Icon from '../base/Icon.astro';
import Guides from './Guides.astro';
import Req from './Req.astro';
import { asset, link } from '../base/url';
import { footer, ui, forms } from '../content/site';
import { tidy } from './text';
const u = footer.updates;
---
<footer class="foot" data-tone="dark">
  <Guides />
  <div class="foot__in">
    <div class="foot__top g6">
      <a class="foot__logo" href={link()} aria-label={ui.home}>
        <img src={asset('img/logo/foundation-white.png')} alt="" width="1868" height="642" loading="lazy" />
      </a>
      <div class="foot__updates">
        <h2 class="key" id="updates-title">{u.label}</h2>
        <p class="small">{u.text}</p>
        <form data-form="updates" data-thanks={ui.updatesThanks} data-endpoint={forms.endpoint} data-sending={forms.sending} aria-labelledby="updates-title">
          <div class="hp" aria-hidden="true"><label>website <input type="text" name="website" tabindex="-1" autocomplete="off" /></label></div>
          <p class="small">{ui.requiredNote}</p>
          <label class="foot__label" for="updates-email">{u.placeholder} <Req /></label>
          <div class="foot__field">
            <input id="updates-email" type="email" name="email" autocomplete="email" required />
            <button class="cta" type="submit">{u.submit}<Icon name="play" /></button>
          </div>
          <label class="check"><input type="checkbox" name="consent" required /><span>{u.consent} <Req /></span></label>
          <p class="form__error small" role="alert" tabindex="-1" data-form-error hidden>{forms.failed}</p>
        </form>
      </div>
    </div>
    <span class="rule" data-draw></span>
    <div class="foot__mid g6">
      <div class="foot__text small">
        <p>{tidy(footer.disclosure)}</p>
        <p>{tidy(footer.separate)}</p>
      </div>
      <div class="foot__contact">
        <h2 class="key">{footer.contactLabel}</h2>
        <ul role="list">
          {footer.emails.map((e) => <li><a href={`mailto:${e}`}><span>{e}</span></a></li>)}
        </ul>
      </div>
      <ul class="foot__links" role="list">
        {footer.links.map((l) => <li><a href={link(l.slug)}><span>{l.label}</span></a></li>)}
      </ul>
    </div>
    <span class="rule" data-draw></span>
    <p class="foot__base small">{footer.copyright}</p>
  </div>
</footer>
