---
// Direction C, "gilded": donate.
import Layout from '../../directions/c/Layout.astro';
import Arc from '../../directions/c/Arc.astro';
import Cap from '../../directions/c/Cap.astro';
import Corners from '../../directions/c/Corners.astro';
import Cta from '../../directions/c/Cta.astro';
import Label from '../../directions/c/Label.astro';
import Statue from '../../directions/c/Statue.astro';
import { donate, org, shown } from '../../content/site';

const levels = donate.levels.filter((level) => shown(level.key));
---
<Layout title={donate.label} current="donate">
  <!-- hero -->
  <section class="sec don-hero tone-atlas">
    <Arc x={2.72} w={4} top="calc(var(--nav-h) + 40px)" xm={0.5} wm={4.4} topm="52%" orbit class="don-hero__arc" />
    <Arc x={-1} w={2} top="62%" xm={-1} wm={2} topm="30%" />
    <div class="grid plinth don-hero__grid">
      <Label text={donate.label} class="don-hero__label" />
      <h1 class="h1 don-hero__h1" data-arrive><Cap text={donate.heading} /></h1>
      <Statue name="atlas" class="don-hero__statue" eager />
      <div class="big don-hero__body" data-rise style="--d:0.6s">
        {donate.body.map((p) => <p>{p}</p>)}
      </div>
      <div class="don-hero__cta" data-rise style="--d:0.75s">
        <Cta framed label={donate.button.label} href="#give" />
      </div>
    </div>
  </section>

  <!-- ways to give -->
  <section class="sec don-levels tone-sf2">
    <Arc x={3.2} w={4} top="-6%" xm={1.4} wm={4} topm="0" />
    <div class="grid">
      <Label as="h2" text={donate.levelsLabel} class="don-levels__label" />
      <p class="statement don-levels__money" data-arrive>{donate.money}</p>
      <div class="don-levels__stage">
        <Statue name="sf2" class="don-levels__statue" />
        <ul class="don-levels__cards card-row">
          {levels.map((level, i) => (
            <li class="card" data-rise style={`--d:${i * 0.14}s`}>
              <Corners />
              <h3 class="don-levels__name">{level.label}</h3>
              <p class="figure__n don-levels__amount">{level.amount}</p>
              <p class="don-levels__text">{level.text}</p>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <!-- give -->
  <section class="sec sec--tight-top don-give tone-atlas" id="give">
    <Arc x={1} w={4} top="-14%" xm={0} wm={4} topm="6%" orbit reverse />
    <div class="card don-give__panel">
      <Corners />
      <div class="don-give__main">
        <h2 class="h2" data-arrive>{donate.when}</h2>
        <p class="lede don-give__deductible" data-rise>{donate.deductible}</p>
        <div class="don-give__act" data-rise style="--d:0.12s">
          <Cta framed external class="cta--wide" label={donate.button.label} href={donate.button.href} />
          <p class="small don-give__disclosure">{donate.disclosure}</p>
          <p class="small don-give__note">{donate.buttonNote}</p>
        </div>
      </div>
      <div class="don-give__side" data-rise style="--d:0.2s">
        <p class="big">{donate.larger}</p>
        <p class="don-give__mail"><a class="mail" href={`mailto:${org.majorGiftsEmail}`}>{org.majorGiftsEmail}</a>.</p>
      </div>
    </div>
  </section>
</Layout>

<style is:global>
  .don-hero { padding-top: calc(var(--nav-h) + 92px); padding-bottom: 0; }
  .don-hero__grid { padding-bottom: 92px; }
  .don-hero__label { grid-column: 1 / 5; }
  .don-hero__h1 { grid-column: 1 / 5; margin-top: 58px; font-size: clamp(42px, 6.1vw, 90px); line-height: 0.93; padding-right: 4%; }
  .don-hero__body { grid-column: 1 / 4; margin-top: 52px; padding-right: 36px; }
  .don-hero__body p + p { margin-top: 0.8em; }
  .don-hero__cta { grid-column: 1 / 4; margin-top: 40px; }
  .don-hero__statue { right: calc(var(--margin) - 0.55 * (100% - 2 * var(--margin)) / 6); bottom: 0; width: calc(3.5 * (100% - 2 * var(--margin)) / 6); }

  .don-levels__label { grid-column: 1 / 5; }
  .don-levels__money { grid-column: 1 / 5; margin-top: 28px; }
  .don-levels__stage { grid-column: 1 / 7; position: relative; margin-top: 96px; }
  .don-levels__statue { right: -4%; bottom: calc(100% - 46px); width: 40%; }
  .don-levels__cards { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 12px; }
  .don-levels__cards .card { display: flex; flex-direction: column; min-height: 400px; padding: 40px 36px 40px; }
  .don-levels__name { font: 700 var(--label) / 1.3 var(--mono); letter-spacing: var(--tracking-label); text-transform: uppercase; color: var(--ink); }
  .don-levels__amount { margin-top: 36px; padding-bottom: 40px; border-bottom: 1px solid var(--rule); font-size: clamp(56px, 6.1vw, 92px); }
  .don-levels__text { margin-top: 28px; }

  .don-give__panel { display: grid; grid-template-columns: repeat(6, minmax(0, 1fr)); align-items: end; padding: 80px 0 84px; background: transparent; }
  .don-give__main { grid-column: 1 / 5; padding: 0 60px 0 calc(100% / 12); }
  .don-give__deductible { margin-top: 30px; max-width: 22em; }
  .don-give__act { margin-top: 44px; max-width: 520px; }
  .don-give__disclosure { margin-top: 18px; }
  .don-give__note { margin-top: 10px; }
  .don-give__side { grid-column: 5 / 7; padding-right: 48px; padding-bottom: 4px; }
  .don-give__mail { margin-top: 10px; font-family: var(--serif); font-weight: 300; font-size: clamp(24px, 2.1vw, 30px); letter-spacing: -0.02em; line-height: 1.2; color: var(--gold); overflow-wrap: anywhere; }

  @media (max-width: 1199.98px) {
    .don-hero__h1 { grid-column: 1 / 5; }
    .don-hero__statue { width: calc(3.4 * (100% - 2 * var(--margin)) / 6); right: calc(var(--margin) - 1 * (100% - 2 * var(--margin)) / 6); }
    .don-levels__cards .card { padding: 34px 24px; min-height: 320px; }
    .don-give__panel { padding: 60px 0; }
    .don-give__main { grid-column: 1 / 7; padding: 0 40px; }
    .don-give__side { grid-column: 1 / 7; padding: 44px 40px 0; }
  }

  @media (max-width: 809.98px) {
    .statue { position: relative; inset: auto; }
    .don-hero { padding-top: calc(var(--nav-h) + 48px); }
    .don-hero__grid { padding-bottom: 0; }
    .don-hero__h1 { margin-top: 40px; padding-right: 0; }
    .don-hero__body { margin-top: 32px; padding-right: 0; }
    .don-hero__cta { margin-top: 20px; }
    .don-hero__statue { order: 9; width: 112%; margin: 28px -20% 0 auto; align-self: flex-end; }
    .don-levels__money { margin-top: 22px; }
    .don-levels__stage { margin-top: 12px; }
    .don-levels__statue { width: 92%; margin: 0 -10% -46px auto; }
    .don-levels__cards { grid-template-columns: 1fr; gap: 12px; }
    .don-levels__cards .card { min-height: 0; padding: 32px 26px; }
    .don-levels__amount { margin-top: 22px; padding-bottom: 28px; font-size: 64px; }
    .don-levels__text { margin-top: 22px; }
    .don-give__panel { display: block; padding: 44px 0 48px; }
    .don-give__main { padding: 0 24px; }
    .don-give__side { padding: 40px 24px 0; }
    .don-give__mail a { display: inline-block; min-height: 44px; padding-top: 8px; }
    .don-give__act { margin-top: 32px; }
  }
</style>
