---
// Direction C, "gilded": home.
import Layout from '../../directions/c/Layout.astro';
import Arc from '../../directions/c/Arc.astro';
import Cap from '../../directions/c/Cap.astro';
import Corners from '../../directions/c/Corners.astro';
import Cta from '../../directions/c/Cta.astro';
import Faq from '../../directions/c/Faq.astro';
import Label from '../../directions/c/Label.astro';
import Statue from '../../directions/c/Statue.astro';
import Icon from '../../base/Icon.astro';
import { page } from '../../base/url';
import { home, faq, figures, shown } from '../../content/site';

// The hero heading is set on two lines on wide screens: the first two words, then the rest.
const words = home.hero.heading.split(' ');
const lineOne = words.slice(0, 2).join(' ');
const lineTwo = words.slice(2).join(' ');

const lineageFigures = home.lineage.figures
  .filter((key) => shown(key))
  .map((key) => (figures as Record<string, any>)[key] as { value: string; label: string });

const questions = home.faq.ids
  .map((id) => faq.donors.find((item) => item.id === id))
  .filter((item): item is (typeof faq.donors)[number] => Boolean(item));
---
<Layout current="home">
  <!-- hero -->
  <section class="sec hero tone-arcadia">
    <Arc x={1.68} w={4} top="calc(var(--nav-h) + 6px)" xm={0.4} wm={4} topm="250px" orbit class="hero__arc" />
    <Arc x={0} w={2} top="58%" xm={-1} wm={2} topm="72%" />
    <div class="grid hero__grid">
      <h1 class="h1 hero__h1" data-arrive><span class="line"><Cap text={lineOne} /></span> <span class="line">{lineTwo}</span></h1>
      <Statue name="arcadia" class="hero__statue" eager />
      <p class="lede hero__sub" data-rise style="--d:0.5s">{home.hero.subline}</p>
      <div class="hero__body" data-rise style="--d:0.65s">
        {home.hero.body.map((p) => <p>{p}</p>)}
      </div>
      <div class="cta-row hero__cta" data-rise style="--d:0.8s">
        <Cta framed label={home.hero.primary.label} href={page('c', home.hero.primary.slug)} />
        <Cta label={home.hero.secondary.label} href={page('c', home.hero.secondary.slug)} />
      </div>
    </div>
  </section>

  <!-- the problem -->
  <section class="sec problem tone-sf2">
    <Arc x={-1} w={4} top="6%" xm={-1.4} wm={4} topm="120px" />
    <div class="grid plinth problem__grid">
      <Label text={home.problem.label} class="problem__label" />
      <h2 class="h2 problem__h2" data-arrive>{home.problem.heading}</h2>
      <Statue name="sf2" class="problem__statue" />
      <ol class="problem__list">
        {home.problem.items.map((item, i) => (
          <li data-rise style={`--d:${i * 0.12}s`}><p>{item}</p></li>
        ))}
      </ol>
    </div>
  </section>

  <!-- who we serve -->
  <section class="sec who tone-inventors">
    <Arc x={3} w={4} top="-4%" xm={1.2} wm={4} topm="40px" orbit reverse />
    <div class="grid">
      <Label text={home.who.label} class="who__label" />
      <h2 class="h2 who__h2" data-arrive>{home.who.heading}</h2>
      <div class="who__stage">
        <Statue name="inventors" class="who__statue" />
        <ul class="who__examples">
          {home.who.examples.map((example, i) => (
            <li data-rise style={`--d:${i * 0.14}s`}>
              <Icon name="sparkle" size={12} />
              <p class="lede">{example}</p>
            </li>
          ))}
        </ul>
      </div>
      <p class="big who__close" data-rise>{home.who.close}</p>
      <p class="small who__note" data-rise>{home.who.note}</p>
    </div>
  </section>

  <!-- what fellows get -->
  <section class="sec get tone-biopunk">
    <Arc x={-0.6} w={4} top="-2%" xm={-1.6} wm={4} topm="30px" />
    <Arc x={4} w={2} top="16%" xm={2.6} wm={2} topm="8%" />
    <div class="grid">
      <Label text={home.get.label} class="get__label" />
      <h2 class="h2 get__h2" data-arrive>{home.get.heading}</h2>
      <div class="get__stage">
        <Statue name="biopunk" flip class="get__statue" />
        <ul class="get__cards card-row">
          {home.get.items.map((item, i) => (
            <li class="card" data-rise style={`--d:${i * 0.12}s`}>
              <Corners />
              <h3 class="h3 get__title">{item.label}</h3>
              <p>{item.text}</p>
            </li>
          ))}
        </ul>
      </div>
      <p class="big get__close" data-rise>{home.get.close}</p>
    </div>
  </section>

  <!-- what it costs fellows -->
  <section class="sec cost">
    <Arc x={-2.4} w={4} top="18%" xm={-3} wm={4} topm="30%" />
    <div class="cost__ring">
      <Arc x={0} w={6} top="0" class="arc--fill" orbit />
      <Label text={home.cost.label} />
      <p class="statement cost__statement" data-arrive>{home.cost.statement}</p>
    </div>
  </section>

  <!-- where we come from -->
  <section class="sec lineage tone-odyssey">
    <Arc x={2.7} w={4} top="14%" xm={0.8} wm={4} topm="46%" />
    <div class="grid plinth lineage__grid">
      <Label text={home.lineage.label} class="lineage__label" />
      <h2 class="h2 lineage__h2" data-arrive>{home.lineage.heading}</h2>
      <ul class="lineage__figs">
        {lineageFigures.map((f, i) => (
          <li class="figure" data-rise style={`--d:${i * 0.14}s`}>
            <span class="figure__n">{f.value}</span>
            <span class="figure__l">{f.label}</span>
          </li>
        ))}
      </ul>
      <Statue name="odyssey" class="lineage__statue" />
      <div class="lineage__text" data-rise>
        <p class="big">{home.lineage.text}</p>
        <p class="big">{home.lineage.own}</p>
      </div>
    </div>
  </section>

  <!-- what we will report -->
  <section class="sec report">
    <Arc x={1} w={4} top="-12%" xm={0} wm={4} topm="4%" orbit />
    <div class="grid">
      <Label text={home.report.label} class="report__label" />
      <h2 class="h2 report__h2" data-arrive>{home.report.heading}</h2>
      <ul class="report__items">
        {home.report.items.map((item, i) => (
          <li data-rise style={`--d:${i * 0.12}s`}>
            <Icon name="sparkle" size={12} />
            <p class="lede">{item}</p>
          </li>
        ))}
      </ul>
      <p class="small report__note" data-rise>{home.report.note}</p>
    </div>
  </section>

  <!-- give -->
  <section class="sec give tone-atlas" id="give">
    <Arc x={-0.76} w={4} top="0" xm={-0.6} wm={4.6} topm="70px" orbit reverse class="give__arc" />
    <div class="grid plinth give__grid">
      <Label text={home.give.label} class="give__label" />
      <h2 class="h1 h1--page give__h2" data-arrive>{home.give.heading}</h2>
      <Statue name="atlas" class="give__statue" />
      <p class="lede give__text" data-rise>{home.give.text}</p>
      <div class="give__act" data-rise style="--d:0.15s">
        <Cta framed class="cta--wide" label={home.give.button.label} href={page('c', home.give.button.slug)} />
        <p class="small give__disclosure">{home.give.disclosure}</p>
      </div>
    </div>
  </section>

  <!-- questions -->
  <section class="sec hfaq tone-vienna">
    <Arc x={3.4} w={4} top="24%" xm={1.4} wm={4} topm="20px" />
    <div class="grid plinth hfaq__grid">
      <div class="hfaq__head">
        <Label text={home.faq.label} />
        <h2 class="h2 hfaq__h2" data-arrive>{home.faq.heading}</h2>
      </div>
      <Statue name="vienna" flip class="hfaq__statue" />
      <div class="hfaq__list" data-rise>
        <Faq items={questions} />
        <Cta label={home.faq.more.label} href={page('c', home.faq.more.slug)} class="hfaq__more" />
      </div>
    </div>
  </section>
</Layout>

<style is:global>
  /* ---------------- hero */
  .hero { display: flex; flex-direction: column; min-height: max(100svh, 800px); padding-top: calc(var(--nav-h) + 78px); padding-bottom: 0; }
  .hero__grid { flex: 1; align-content: start; padding-bottom: 76px; border-bottom: 1px solid var(--rule); }
  .hero__h1 { grid-column: 1 / 6; }
  .hero__h1 .line { display: block; }
  .hero__sub { grid-column: 1 / 4; max-width: 16.5em; margin-top: 46px; }
  .hero__body { grid-column: 1 / 4; max-width: 29em; margin-top: 26px; }
  .hero__body p + p { margin-top: 0.7em; }
  .hero__cta { grid-column: 1 / 4; margin-top: 40px; }
  .hero__statue { bottom: 0; right: 8.6%; width: min(64%, 104svh); }

  /* ---------------- the problem */
  .problem__label { grid-column: 3 / 7; }
  .problem__h2 { grid-column: 3 / 7; margin-top: 28px; }
  .problem__list { grid-column: 4 / 7; margin-top: 76px; counter-reset: reason; border-top: 1px solid var(--rule); }
  .problem__list li { display: grid; grid-template-columns: 1fr 2fr; align-items: start; padding: 30px 0 36px; counter-increment: reason; }
  .problem__list li + li { border-top: 1px solid var(--rule); }
  .problem__list li::before { content: counter(reason); font-family: var(--serif); font-weight: 300; font-size: clamp(44px, 4.2vw, 60px); line-height: 0.8; letter-spacing: var(--tracking-display); color: var(--gold); }
  .problem__statue { left: calc(var(--margin) - 10.5%); bottom: var(--pad); width: calc(3.7 * (100% - 2 * var(--margin)) / 6); }

  /* ---------------- who we serve */
  .who__label { grid-column: 1 / 5; }
  .who__h2 { grid-column: 1 / 5; margin-top: 28px; }
  .who__stage { grid-column: 1 / 7; position: relative; margin-top: 92px; }
  .who__statue { right: -5%; bottom: 100%; width: 44%; }
  .who__examples { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); border-top: 1px solid var(--rule); border-bottom: 1px solid var(--rule); }
  .who__examples li { padding: 30px 36px 44px 0; }
  .who__examples li + li { padding-left: 28px; }
  .who__examples svg { color: var(--accent); }
  .who__examples .lede { margin-top: 26px; }
  .who__close { grid-column: 1 / 4; margin-top: 52px; padding-right: 36px; }
  .who__note { grid-column: 5 / 7; margin-top: 56px; padding-left: 28px; }

  /* ---------------- what fellows get */
  .get__label { grid-column: 3 / 7; }
  .get__h2 { grid-column: 3 / 7; margin-top: 28px; }
  .get__stage { grid-column: 1 / 7; position: relative; margin-top: 100px; }
  .get__statue { left: calc(-1 * var(--margin)); bottom: calc(100% - 44px); width: 43%; }
  .get__cards { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 12px; }
  .get__cards .card { display: flex; flex-direction: column; min-height: 330px; }
  .get__title { font-size: clamp(30px, 2.9vw, 42px); padding-bottom: 30px; border-bottom: 1px solid var(--rule); }
  .get__cards .card p { margin-top: auto; padding-top: 28px; font-size: 17px; line-height: 1.55; }
  .get__close { grid-column: 3 / 7; margin-top: 56px; max-width: 34em; }

  /* ---------------- what it costs fellows */
  .cost { padding-top: calc(var(--pad) * 0.25); padding-bottom: calc(var(--pad) * 0.25); }
  .cost__ring { position: relative; width: calc(4 * (100% / 6)); aspect-ratio: 1; margin: 0 auto; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 36px; padding: 0 8.5%; text-align: center; }
  .arc.arc--fill { inset: 0; width: 100%; }

  /* ---------------- where we come from */
  .lineage__grid { padding-bottom: 96px; }
  .lineage__label { grid-column: 1 / 5; }
  .lineage__h2 { grid-column: 1 / 5; margin-top: 28px; }
  .lineage__figs { grid-column: 1 / 4; margin-top: 84px; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); border-top: 1px solid var(--rule); border-bottom: 1px solid var(--rule); }
  .lineage__figs .figure { padding: 34px 12px 30px 0; }
  .lineage__figs .figure + .figure { padding-left: 18px; }
  .lineage__figs .figure__n { font-size: clamp(56px, 7.1vw, 104px); }
  .lineage__figs .figure__l { margin-top: 22px; }
  .lineage__text { grid-column: 1 / 4; margin-top: 48px; padding-right: 36px; }
  .lineage__text p + p { margin-top: 0.8em; }
  .lineage__statue { right: calc(var(--margin) - 9%); bottom: var(--pad); width: calc(3.5 * (100% - 2 * var(--margin)) / 6); }

  /* ---------------- what we will report */
  .report__label { grid-column: 1 / 5; }
  .report__h2 { grid-column: 1 / 5; margin-top: 28px; }
  .report__items { grid-column: 1 / 7; margin-top: 84px; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); border-top: 1px solid var(--rule); border-bottom: 1px solid var(--rule); }
  .report__items li { display: flex; flex-direction: column; justify-content: space-between; gap: 28px; min-height: 250px; padding: 28px 28px 36px 0; }
  .report__items li + li { padding-left: 28px; border-left: 1px solid var(--rule); }
  .report__items svg { color: var(--gold); }
  .report__note { grid-column: 1 / 4; margin-top: 26px; }

  /* ---------------- give */
  .give__grid { padding-bottom: 104px; }
  .give__label { grid-column: 4 / 7; }
  .give__h2 { grid-column: 4 / 7; margin-top: 28px; font-size: clamp(48px, 6.7vw, 100px); }
  .give__text { grid-column: 4 / 7; margin-top: 36px; }
  .give__act { grid-column: 4 / 6; margin-top: 44px; }
  .give__disclosure { margin-top: 18px; }
  .give__statue { left: calc(var(--margin) - 0.62 * (100% - 2 * var(--margin)) / 6); bottom: var(--pad); width: calc(3.8 * (100% - 2 * var(--margin)) / 6); }
  .arc.give__arc { top: auto; bottom: calc(var(--pad) + 0.2 * (100% - 2 * var(--margin)) / 6); }

  /* ---------------- questions */
  .hfaq__grid { padding-bottom: 96px; }
  .hfaq__head { grid-column: 5 / 7; grid-row: 1; padding-left: 28px; }
  .hfaq__h2 { margin-top: 28px; }
  .hfaq__list { grid-column: 1 / 5; grid-row: 1; padding-right: 36px; }
  .hfaq__more { margin-top: 36px; }
  .hfaq__statue { right: calc(var(--margin) - 5%); bottom: var(--pad); width: calc(2.6 * (100% - 2 * var(--margin)) / 6); }

  /* ---------------- tablet */
  @media (max-width: 1199.98px) {
    .hero { min-height: 0; }
    .hero__statue { width: 66%; right: calc(var(--margin) - 12%); }
    .hero__sub, .hero__body, .hero__cta { grid-column: 1 / 4; }
    .problem__h2 { grid-column: 3 / 7; }
    .problem__list { grid-column: 3 / 7; }
    .problem__list li { grid-template-columns: 1fr 3fr; }
    .problem__statue { width: calc(3.4 * (100% - 2 * var(--margin)) / 6); left: calc(var(--margin) - 16%); }
    .who__examples li { padding-right: 20px; }
    .who__examples li + li { padding-left: 20px; }
    .get__cards { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .get__cards .card { min-height: 260px; }
    .cost__ring { width: 100%; padding: 0 16%; }
    .lineage__figs, .lineage__text { grid-column: 1 / 5; }
    .lineage__statue { width: calc(3.2 * (100% - 2 * var(--margin)) / 6); right: calc(var(--margin) - 14%); }
    .report__items { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .report__items li { min-height: 200px; }
    .report__items li:nth-child(3) { padding-left: 0; border-left: 0; }
    .report__items li:nth-child(n + 3) { border-top: 1px solid var(--rule); }
    .give__act { grid-column: 4 / 7; }
    .hfaq__head { grid-column: 5 / 7; padding-left: 20px; }
  }

  /* ---------------- phone */
  @media (max-width: 809.98px) {
    .statue { position: relative; inset: auto; }

    .hero { padding-top: calc(var(--nav-h) + 44px); }
    .hero__grid { padding-bottom: 56px; }
    .hero__h1 .line { display: inline; }
    .hero__statue { order: 1; width: 112%; margin: -13% -16% 0 auto; align-self: flex-end; }
    .hero__sub { order: 2; margin-top: 0; padding-top: 30px; border-top: 1px solid var(--rule); }
    .hero__body { order: 3; }
    .hero__cta { order: 4; margin-top: 30px; }

    .problem__h2 { margin-top: 22px; }
    .problem__statue { order: 3; width: 108%; margin: -12% 0 0 -22%; }
    .problem__list { order: 2; margin-top: 44px; border-bottom: 1px solid var(--rule); }
    .problem__list li { grid-template-columns: 1fr 3fr; padding: 24px 0 28px; }

    .who__h2 { margin-top: 22px; }
    .who__stage { margin-top: 20px; }
    .who__statue { width: 92%; margin: -24% -12% 0 auto; }
    .who__examples { display: block; }
    .who__examples li, .who__examples li + li { padding: 26px 0 32px; }
    .who__examples li + li { border-top: 1px solid var(--rule); }
    .who__examples .lede { margin-top: 18px; }
    .who__close { margin-top: 36px; padding-right: 0; }
    .who__note { margin-top: 20px; padding-left: 0; }

    .get__h2 { margin-top: 22px; }
    .get__stage { margin-top: 16px; }
    .get__statue { width: 96%; margin: 0 0 -40px calc(-1 * var(--margin)); }
    .get__cards { grid-template-columns: 1fr; }
    .get__cards .card { min-height: 0; padding: 32px 26px 30px; }
    .get__title { padding-bottom: 20px; }
    .get__close { margin-top: 36px; }

    .cost { padding-top: var(--pad); padding-bottom: var(--pad); }
    .cost__ring { width: 100%; padding: 0 9%; gap: 22px; }
    .cost__statement { font-size: 27px; }

    .lineage__grid { padding-bottom: 0; }
    .lineage__h2 { margin-top: 22px; }
    .lineage__figs { margin-top: 44px; }
    .lineage__figs .figure { padding: 22px 6px 20px 0; } .lineage__figs .figure + .figure { padding-left: 10px; } .lineage__figs .figure__n { font-size: 12.4vw; white-space: nowrap; } .lineage__figs .figure__l { font-size: 10px; }
    .lineage__text { margin-top: 32px; padding-right: 0; }
    .lineage__statue { order: 9; width: 104%; margin: 28px -18% 0 auto; align-self: flex-end; }

    .report__h2 { margin-top: 22px; }
    .report__items { margin-top: 44px; grid-template-columns: 1fr; }
    .report__items li { min-height: 0; flex-direction: row; justify-content: flex-start; align-items: baseline; gap: 16px; padding: 22px 0 24px; }
    .report__items li + li { padding-left: 0; border-left: 0; border-top: 1px solid var(--rule); }
    .report__items svg { flex: none; }

    .give__grid { padding-bottom: 0; border-bottom: 0; }
    .give__h2 { margin-top: 22px; }
    .give__text { margin-top: 24px; }
    .give__act { margin-top: 30px; }
    .give__statue { order: 9; width: 112%; margin: 40px 0 0 -14%; }
    .give__grid::after { content: ''; order: 10; border-bottom: 1px solid var(--rule); }

    .hfaq__grid { padding-bottom: 0; }
    .hfaq__head { padding-left: 0; }
    .hfaq__h2 { margin-top: 22px; }
    .hfaq__list { margin-top: 40px; padding-right: 0; }
    .hfaq__statue { order: 9; width: 84%; margin: 0 -8% 0 auto; align-self: flex-end; }
  }
</style>
