---
// Direction C, "gilded": about.
import Layout from '../../directions/c/Layout.astro';
import Arc from '../../directions/c/Arc.astro';
import Cap from '../../directions/c/Cap.astro';
import Label from '../../directions/c/Label.astro';
import Statue from '../../directions/c/Statue.astro';
import { about } from '../../content/site';
---
<Layout title={about.label} current="about">
  <!-- hero: the mission's first sentence, as a large statement -->
  <section class="sec abt-hero tone-arcadia">
    <Arc x={2.6} w={4} top="calc(var(--nav-h) + 30px)" xm={0.6} wm={4.2} topm="48%" orbit />
    <Arc x={-1} w={2} top="66%" xm={-1} wm={2} topm="26%" />
    <div class="grid plinth abt-hero__grid">
      <Label text={about.label} class="abt-hero__label" />
      <h1 class="h1 h1--long abt-hero__h1" data-arrive><Cap text={about.heading} /></h1>
      <Statue name="arcadia" class="abt-hero__statue" eager />
      <p class="big abt-hero__body" data-rise style="--d:0.7s">{about.body}</p>
    </div>
  </section>

  <!-- how it is run -->
  <section class="sec abt-gov tone-odyssey">
    <Arc x={-1.1} w={4} top="8%" xm={-1.6} wm={4} topm="56%" orbit reverse />
    <div class="grid plinth abt-gov__grid">
      <Label text={about.governance.label} class="abt-gov__label" />
      <h2 class="h2 abt-gov__h2" data-arrive>{about.governance.heading}</h2>
      <Statue name="odyssey" class="abt-gov__statue" />
      <ul class="abt-gov__rows">
        {about.governance.items.map((item, i) => (
          <li data-rise style={`--d:${i * 0.12}s`}>
            <h3 class="h3 abt-gov__name">{item.label}</h3>
            <p class="big">{item.text}</p>
          </li>
        ))}
      </ul>
      <p class="lede abt-gov__status" data-rise>{about.governance.status}</p>
    </div>
  </section>

  <!-- board and officers (collapsed), contact -->
  <section class="sec abt-end tone-vienna">
    <Arc x={2.4} w={4} top="-20%" xm={1} wm={4} topm="-10%" />
    <div class="grid">
      <div class="faq abt-board" data-rise>
        <details class="faq__row">
          <summary>
            <h2 class="faq__q">{about.board.label}</h2>
            <span class="faq__icon" aria-hidden="true"></span>
          </summary>
          <ul class="abt-board__people">
            {about.board.people.map((person) => (
              <li>
                <p class="abt-board__name">{person.name}</p>
                <p class="small">{person.role}</p>
              </li>
            ))}
          </ul>
        </details>
      </div>

      <div class="abt-contact" data-rise>
        <Label as="h2" text={about.contact.label} />
        <ul class="abt-contact__list">
          {about.contact.emails.map((e) => (
            <li><a class="mail" href={`mailto:${e}`}>{e}</a></li>
          ))}
        </ul>
      </div>
    </div>
  </section>
</Layout>

<style is:global>
  .abt-hero { padding-top: calc(var(--nav-h) + 92px); padding-bottom: 0; }
  .abt-hero__grid { padding-bottom: 100px; }
  .abt-hero__label { grid-column: 1 / 5; }
  .abt-hero__h1 { grid-column: 1 / 5; margin-top: 52px; padding-right: 2%; }
  .abt-hero__body { grid-column: 1 / 4; margin-top: 64px; padding-right: 36px; }
  .abt-hero__statue { right: calc(var(--margin) - 0.9 * (100% - 2 * var(--margin)) / 6); bottom: 0; width: calc(3.9 * (100% - 2 * var(--margin)) / 6); }

  .abt-gov__grid { padding-bottom: 96px; }
  .abt-gov__label { grid-column: 3 / 7; }
  .abt-gov__h2 { grid-column: 3 / 7; margin-top: 28px; }
  .abt-gov__rows { grid-column: 3 / 7; margin-top: 76px; border-top: 1px solid var(--rule); border-bottom: 1px solid var(--rule); }
  .abt-gov__rows li { display: grid; grid-template-columns: 1fr 1fr; align-items: start; padding: 34px 0 40px; }
  .abt-gov__rows li + li { border-top: 1px solid var(--rule); }
  .abt-gov__name { font-size: clamp(28px, 2.6vw, 38px); padding-right: 28px; }
  .abt-gov__status { grid-column: 3 / 7; margin-top: 48px; max-width: 22em; }
  .abt-gov__statue { left: calc(var(--margin) - 0.95 * (100% - 2 * var(--margin)) / 6); bottom: var(--pad); width: calc(3.5 * (100% - 2 * var(--margin)) / 6); }

  .abt-board { grid-column: 1 / 7; }
  .abt-board__people { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); padding: 6px 0 40px; }
  .abt-board__people li { padding-right: 28px; }
  .abt-board__name { font-family: var(--serif); font-weight: 300; font-size: clamp(24px, 2.1vw, 30px); letter-spacing: -0.02em; line-height: 1.15; color: var(--gold); margin-bottom: 8px; }
  .abt-contact { grid-column: 1 / 7; margin-top: 96px; display: grid; grid-template-columns: repeat(6, minmax(0, 1fr)); align-items: baseline; }
  .abt-contact .label { grid-column: 1 / 3; }
  .abt-contact__list { grid-column: 3 / 7; }
  .abt-contact__list li + li { margin-top: 14px; }
  .abt-contact__list a { display: inline-block; font-family: var(--serif); font-weight: 300; font-size: clamp(26px, 3.4vw, 48px); letter-spacing: -0.03em; line-height: 1.15; color: var(--gold); overflow-wrap: anywhere; }

  @media (max-width: 1199.98px) {
    .abt-hero__statue { right: calc(var(--margin) - 1.4 * (100% - 2 * var(--margin)) / 6); }
    .abt-gov__rows li { grid-template-columns: 1fr; gap: 14px; }
    .abt-gov__statue { left: calc(var(--margin) - 1.5 * (100% - 2 * var(--margin)) / 6); }
  }

  @media (max-width: 809.98px) {
    .statue { position: relative; inset: auto; }
    .abt-hero { padding-top: calc(var(--nav-h) + 48px); }
    .abt-hero__grid { padding-bottom: 0; }
    .abt-hero__h1 { margin-top: 22px; padding-right: 0; }
    .abt-hero__body { margin-top: 36px; padding-right: 0; }
    .abt-hero__statue { order: 9; width: 120%; margin: -6% -22% 0 auto; align-self: flex-end; }
    .abt-gov__grid { padding-bottom: 0; }
    .abt-gov__h2 { margin-top: 22px; }
    .abt-gov__rows { margin-top: 40px; }
    .abt-gov__rows li { padding: 26px 0 30px; }
    .abt-gov__status { margin-top: 32px; }
    .abt-gov__statue { order: 9; width: 104%; margin: 28px 0 0 -20%; }
    .abt-board__people { grid-template-columns: 1fr; gap: 22px; padding-bottom: 30px; }
    .abt-contact { display: block; margin-top: 64px; }
    .abt-contact__list { margin-top: 20px; }
    .abt-contact__list a { min-height: 44px; padding: 6px 0; }
  }
</style>
