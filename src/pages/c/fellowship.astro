---
// Direction C, "gilded": fellowship.
import Layout from '../../directions/c/Layout.astro';
import Arc from '../../directions/c/Arc.astro';
import Cap from '../../directions/c/Cap.astro';
import Corners from '../../directions/c/Corners.astro';
import Cta from '../../directions/c/Cta.astro';
import Label from '../../directions/c/Label.astro';
import Statue from '../../directions/c/Statue.astro';
import Icon from '../../base/Icon.astro';
import { fellowship, ui } from '../../content/site';

type Field = (typeof fellowship.form.fields)[number] & {
  options?: string[]; hint?: string; maxLength?: number;
};
const fields = fellowship.form.fields as Field[];

// Short fields sit two to a row; long ones, and a short one left without a partner, take the full row.
const short = (f?: Field) => !!f && ['text', 'email', 'url', 'select'].includes(f.type);
const wide = new Set<string>();
for (let i = 0; i < fields.length; i++) {
  if (!short(fields[i])) { wide.add(fields[i].id); continue; }
  if (short(fields[i + 1])) { i++; continue; }
  wide.add(fields[i].id);
}
const flag = (f: Field) => (f.required ? ui.required : ui.optional);
---
<Layout title={fellowship.label} current="fellowship">
  <!-- hero -->
  <section class="sec fel-hero tone-sf2">
    <Arc x={2.3} w={4} top="calc(var(--nav-h) + 20px)" xm={0.6} wm={4.2} topm="46%" orbit />
    <Arc x={-0.5} w={2} top="60%" xm={-1} wm={2} topm="24%" />
    <div class="grid plinth fel-hero__grid">
      <Label text={fellowship.label} class="fel-hero__label" />
      <h1 class="h1 fel-hero__h1" data-arrive><Cap text={fellowship.heading} /></h1>
      <Statue name="sf2" class="fel-hero__statue" eager />
      <p class="lede fel-hero__intro" data-rise style="--d:0.5s">{fellowship.intro}</p>
      <div class="fel-hero__cta" data-rise style="--d:0.65s">
        <Cta framed label={fellowship.form.label} href="#interest" />
      </div>
    </div>
  </section>

  <!-- the five sections -->
  <section class="sec fel-facts tone-biopunk">
    <Arc x={3.4} w={4} top="10%" xm={1.6} wm={4} topm="62%" orbit reverse />
    <div class="grid plinth fel-facts__grid">
      <ul class="fel-facts__rows">
        {fellowship.sections.map((s, i) => (
          <li data-rise style={`--d:${i * 0.08}s`}>
            <Label as="h2" text={s.label} />
            <p class="big">{s.text}</p>
          </li>
        ))}
      </ul>
      <Statue name="biopunk" class="fel-facts__statue" />
    </div>
  </section>

  <!-- register your interest -->
  <section class="sec fel-form tone-inventors" id="interest">
    <Arc x={-1.2} w={4} top="4%" xm={-1.6} wm={4} topm="40px" />
    <div class="grid">
      <div class="fel-form__head">
        <Label text={fellowship.form.label} />
        <h2 class="h2 fel-form__h2" data-arrive>{fellowship.form.heading}</h2>
        <p class="fel-form__intro" data-rise>{fellowship.form.intro}</p>
        <Statue name="inventors" class="fel-form__statue" />
      </div>

      <div class="card fel-form__card">
        <Corners />
        <form class="fel-form__form" data-form="interest">
          {fields.map((f) => {
            const cls = ['fel-field', wide.has(f.id) && 'fel-field--wide'];
            if (f.type === 'checkboxes') {
              return (
                <fieldset class:list={cls} aria-describedby={f.hint ? `${f.id}-hint` : undefined}>
                  <legend class="field__label">{f.label}<span class="field__flag">{flag(f)}</span></legend>
                  {f.hint && <p class="field__hint" id={`${f.id}-hint`}>{f.hint}</p>}
                  <div class="fel-field__options">
                    {f.options!.map((o, i) => (
                      <label class="check" for={`${f.id}-${i}`}>
                        <input type="checkbox" id={`${f.id}-${i}`} name={f.id} value={o} />
                        <span>{o}</span>
                      </label>
                    ))}
                  </div>
                </fieldset>
              );
            }
            if (f.type === 'checkbox') {
              return (
                <div class:list={cls}>
                  <label class="check" for={f.id}>
                    <input type="checkbox" id={f.id} name={f.id} required={f.required} />
                    <span>{f.label}<span class="field__flag">{flag(f)}</span></span>
                  </label>
                </div>
              );
            }
            return (
              <div class:list={cls}>
                <label class="field__label" for={f.id}>{f.label}<span class="field__flag">{flag(f)}</span></label>
                {f.type === 'textarea' && (
                  <>
                    <textarea class="input" id={f.id} name={f.id} rows="6" maxlength={f.maxLength} required={f.required} aria-describedby={`${f.id}-count`}></textarea>
                    <p class="small fel-field__count" id={`${f.id}-count`} data-count-for={f.id}><span data-count>{f.maxLength}</span> {ui.charactersLeft}</p>
                  </>
                )}
                {f.type === 'select' && (
                  <select class="input" id={f.id} name={f.id} required={f.required}>
                    <option value="" selected></option>
                    {f.options!.map((o) => <option value={o}>{o}</option>)}
                  </select>
                )}
                {['text', 'email', 'url'].includes(f.type) && (
                  <input
                    class="input"
                    id={f.id}
                    name={f.id}
                    type={f.type}
                    required={f.required}
                    autocomplete={f.id === 'name' ? 'name' : f.id === 'email' ? 'email' : f.id === 'country' ? 'country-name' : f.id === 'city' ? 'address-level2' : f.id === 'state' ? 'address-level1' : 'off'}
                  />
                )}
              </div>
            );
          })}
          <div class="fel-field fel-field--wide fel-form__submit">
            <button class="cta cta--framed" type="submit"><span>{fellowship.form.submit}</span><Icon name="play" /></button>
          </div>
        </form>
        <p class="statement fel-form__thanks" data-thanks-for="interest" role="status" tabindex="-1" hidden>{fellowship.form.thanks}</p>
      </div>
    </div>
  </section>
</Layout>

<style is:global>
  .fel-hero { padding-top: calc(var(--nav-h) + 92px); padding-bottom: 0; }
  .fel-hero__grid { padding-bottom: 96px; }
  .fel-hero__label { grid-column: 1 / 5; }
  .fel-hero__h1 { grid-column: 1 / 5; margin-top: 64px; max-width: 5.6em; }
  .fel-hero__intro { grid-column: 1 / 4; margin-top: 48px; padding-right: 24px; }
  .fel-hero__cta { grid-column: 1 / 4; margin-top: 40px; }
  .fel-hero__statue { right: calc(var(--margin) - 0.2 * (100% - 2 * var(--margin)) / 6); bottom: 0; width: calc(3.7 * (100% - 2 * var(--margin)) / 6); }

  .fel-facts__rows { grid-column: 1 / 5; border-top: 1px solid var(--rule); }
  .fel-facts__rows li { display: grid; grid-template-columns: 1fr 3fr; align-items: start; padding: 36px 0 42px; }
  .fel-facts__rows li + li { border-top: 1px solid var(--rule); }
  .fel-facts__rows .label { padding-top: 9px; padding-right: 16px; }
  .fel-facts__rows .big { padding-right: 48px; }
  .fel-facts__statue { right: calc(-1 * var(--margin)); bottom: var(--pad); width: 42%; }

  .fel-form .grid { align-items: stretch; }
  .fel-form__head { grid-column: 1 / 3; position: relative; padding-right: 28px; display: flex; flex-direction: column; }
  .fel-form__h2 { margin-top: 28px; }
  .fel-form__intro { margin-top: 30px; }
  .fel-form__head { border-bottom: 1px solid var(--rule); }
  .fel-form__statue { position: relative; width: 150%; margin: auto 0 0 -34%; }
  .fel-form__card { grid-column: 3 / 7; padding: 56px 52px 60px; }
  .fel-form__form { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 30px 28px; }
  .fel-field { min-width: 0; margin: 0; padding: 0; border: 0; display: flex; flex-direction: column; }
  .fel-field .input { margin-top: auto; }
  .fel-field--wide { grid-column: 1 / -1; }
  .fel-field__options { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); column-gap: 28px; }
  .fel-field__count { margin-top: 8px; }
  fieldset.fel-field .field__label { padding: 0; }
  .fel-form__submit { margin-top: 12px; align-items: flex-start; }
  .fel-form__thanks { padding: 40px 0; }
  .fel-form__thanks:focus { outline: none; }

  @media (max-width: 1199.98px) {
    .fel-hero__statue { right: calc(var(--margin) - 1.1 * (100% - 2 * var(--margin)) / 6); width: calc(3.6 * (100% - 2 * var(--margin)) / 6); }
    .fel-facts__rows { grid-column: 1 / 6; }
    .fel-facts__rows li { grid-template-columns: 1fr 2.4fr; }
    .fel-facts__statue { width: 40%; }
    .fel-form__head { grid-column: 1 / 7; padding-right: 0; }
    .fel-form__statue { display: none; }
    .fel-form__card { grid-column: 1 / 7; margin-top: 56px; padding: 44px 36px 48px; }
  }

  @media (max-width: 809.98px) {
    .statue { position: relative; inset: auto; }
    .fel-hero { padding-top: calc(var(--nav-h) + 48px); }
    .fel-hero__grid { padding-bottom: 0; }
    .fel-hero__h1 { margin-top: 22px; }
    .fel-hero__intro { margin-top: 28px; padding-right: 0; }
    .fel-hero__cta { margin-top: 28px; }
    .fel-hero__statue { order: 9; width: 108%; margin: 8px -22% 0 auto; align-self: flex-end; }
    .fel-facts__rows li { display: block; padding: 28px 0 32px; }
    .fel-facts__rows .label { padding: 0 0 14px; }
    .fel-facts__rows .big { padding-right: 0; }
    .fel-facts__statue { width: 92%; margin: 20px calc(-1 * var(--margin)) 0 auto; align-self: flex-end; }
    .fel-form__h2 { margin-top: 22px; }
    .fel-form__card { margin-top: 40px; padding: 34px 22px 38px; }
    .fel-form__form { grid-template-columns: 1fr; gap: 26px; }
    .fel-field__options { grid-template-columns: 1fr; }
  }
</style>
