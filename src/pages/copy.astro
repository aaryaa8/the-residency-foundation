---
// Review page: every word on the site, grouped by page, with the name of each line.
// It is generated from src/content/site.ts, so it always matches the live pages.
// It is for internal review and is not linked from the site.
import BaseHead from '../base/BaseHead.astro';
import { link } from '../base/url';
import * as site from '../content/site';

type Row = { key: string; text: string };
const rows = (value: unknown, path: string, out: Row[] = []): Row[] => {
  if (typeof value === 'string') { if (value.trim()) out.push({ key: path, text: value }); }
  else if (Array.isArray(value)) value.forEach((v, i) => rows(v, `${path}[${i + 1}]`, out));
  else if (value && typeof value === 'object') Object.entries(value).forEach(([k, v]) => rows(v, path ? `${path}.${k}` : k, out));
  return out;
};
// internal addresses and settings are left out; only words a visitor can read are listed
const skip = (r: Row) => /(\.href|\.slug|\.id|\.type|\.key|Url|\.endpoint|\.(figures|ids)\[\d+\])$/.test(r.key) || /^https?:\/\//.test(r.text);
const groups = [
  { title: 'Home', page: '', data: site.home, name: 'home' },
  { title: 'Donate', page: 'donate', data: site.donate, name: 'donate' },
  { title: 'Fellowship', page: 'fellowship', data: site.fellowship, name: 'fellowship' },
  { title: 'About', page: 'about', data: site.about, name: 'about' },
  { title: 'FAQ', page: 'faq', data: site.faq, name: 'faq' },
  { title: 'Privacy', page: 'privacy', data: site.privacy, name: 'privacy' },
  { title: 'Navigation and footer', page: '', data: { nav: site.nav, footer: site.footer }, name: '' },
  { title: 'Forms and small interface words', page: 'fellowship', data: { forms: site.forms, ui: site.ui, org: { draftLabel: site.org.draftLabel, description: site.org.description } }, name: '' },
  { title: 'Lines used in more than 1 place', page: '', data: site.lines, name: 'lines' },
  { title: 'Image descriptions (read aloud by screen readers)', page: '', data: site.placeholders, name: 'placeholders' },
  { title: 'Figures and their captions', page: '', data: Object.fromEntries(Object.entries(site.figures as Record<string, any>).filter(([k]) => !k.startsWith('_')).map(([k, v]) => [k, `${v.value}  ·  ${v.label}  ·  ${v.show ? 'shown' : 'hidden'}`])), name: 'figures' },
].map((g) => ({ ...g, rows: rows(g.data, g.name).filter((r) => !skip(r)) }));
const total = groups.reduce((n, g) => n + g.rows.length, 0);
---
<!doctype html>
<html lang="en">
  <head><BaseHead title="All site copy" /></head>
  <body>
    <main>
      <p class="tag">draft for internal review</p>
      <h1>All site copy</h1>
      <p class="lede">The text of the site, grouped by page. The name beside each line is how to refer to it when asking for a change, for example "home.cost.statement". Numbers shown here come from the figures file, so a figure is changed there once. This page is built from the same file as the site, so it always matches what is live. {total} lines.</p>
      <nav aria-label="Pages"><ul>{groups.map((g, i) => <li><a href={`#g${i}`}>{g.title}</a></li>)}</ul></nav>
      {groups.map((g, i) => (
        <section id={`g${i}`}>
          <h2>{g.title} <a class="open" href={link(g.page)}>open the page</a></h2>
          <table>
            <thead><tr><th scope="col">Line</th><th scope="col">Text</th></tr></thead>
            <tbody>
              {g.rows.map((r) => <tr><td class="k">{r.key}</td><td>{r.text}</td></tr>)}
            </tbody>
          </table>
        </section>
      ))}
    </main>
  </body>
</html>
<style>
  main { max-width: 1100px; margin: 0 auto; padding: 48px var(--margin) 96px; }
  .tag { display: inline-block; margin: 0 0 24px; padding: 6px 10px; background: var(--ink); color: var(--ivory); font: 700 10px/1 var(--mono); letter-spacing: 0.06em; text-transform: uppercase; }
  h1 { margin: 0 0 16px; font: 300 clamp(40px, 6vw, 64px)/1 var(--serif); letter-spacing: var(--tracking-display); }
  .lede { max-width: 720px; margin: 0 0 24px; color: var(--ink-70); }
  nav ul { display: flex; flex-wrap: wrap; gap: 8px 20px; margin: 0 0 40px; padding: 0; list-style: none; font-size: 16px; }
  section { margin-top: 56px; }
  h2 { display: flex; flex-wrap: wrap; align-items: baseline; gap: 8px 16px; margin: 0 0 12px; font: 300 32px/1.1 var(--serif); letter-spacing: -0.02em; }
  .open { display: inline-block; padding: 12px 0; font: 400 14px/1.4 var(--serif); letter-spacing: 0; }
  table { width: 100%; border-collapse: collapse; font-size: 16px; line-height: 1.5; }
  th { text-align: left; padding: 8px 12px 8px 0; font-weight: 500; border-bottom: 1px solid var(--ink); }
  td { padding: 10px 12px 10px 0; vertical-align: top; border-bottom: 1px solid var(--ink-15); }
  .k { width: 34%; color: var(--ink-70); font: 500 13px/1.5 var(--mono); overflow-wrap: anywhere; }
  @media (max-width: 809.98px) {
    table, tbody, tr, td { display: block; }
    thead { display: none; }
    tr { padding: 10px 0; border-bottom: 1px solid var(--ink-15); }
    td { padding: 0; border: 0; }
    .k { width: auto; margin-bottom: 4px; }
  }
</style>
