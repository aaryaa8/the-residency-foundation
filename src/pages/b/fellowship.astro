---
import Layout from '../../directions/b/Layout.astro';
import Hero from '../../directions/b/Hero.astro';
import Section from '../../directions/b/Section.astro';
import Icon from '../../base/Icon.astro';
import { fellowship, ui } from '../../content/site';

const n = (i: number) => String(i + 1).padStart(2, '0');
const form = fellowship.form;
type Field = { id: string; label: string; type: string; required: boolean; options?: string[]; hint?: string; maxLength?: number };
const fields = form.fields as Field[];
const wide = (f: Field) => ['textarea', 'checkboxes', 'checkbox'].includes(f.type);
---
<Layout title={fellowship.label} current="fellowship">
  <Hero heading={fellowship.heading} label={fellowship.label} plate={{ name: 'vienna', alt: 'Placeholder image: a marble bust wearing headphones.', ratio: '4 / 5', pos: '100% 100%' }}>
    <p class="hero__sub hero__sub--3 statement" data-reveal style="--i:4">{fellowship.intro}</p>
  </Hero>

  <section class="sec" id="about-the-fellowship">
    <div class="sec__in">
      <span class="rule rule--strong" data-draw></span>
      <ul class="rows rows--full">
        {fellowship.sections.map((s, i, all) => (
          <li class:list={['row ruled', i === all.length - 1 && 'ruled--end']} style={`--i:${i}`}>
            <span class="num row__n" aria-hidden="true">{n(i)}</span>
            <h2 class="label row__k">{s.label}</h2>
            <p class="row__t lead">{s.text}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <Section label={form.label} id="interest">
    <h2 class="h2 sec__h at-2-5 t-wide" data-reveal>{form.heading}</h2>
    <p class="lead at-2-4 cellpad form__intro" data-reveal>{form.intro}</p>
    <form class="form at-2-5 t-wide" data-form="interest" data-thanks={form.thanks}>
      {fields.map((f) => {
        const mark = f.required
          ? <span class="field__req"><span aria-hidden="true">*</span><span class="visually-hidden"> ({ui.required})</span></span>
          : <span class="field__opt">({ui.optional})</span>;
        if (f.type === 'checkboxes') return (
          <fieldset class="field field--wide" aria-describedby={f.hint ? `${f.id}-hint` : undefined}>
            <legend>{f.label} {mark}</legend>
            {f.hint && <p class="field__hint" id={`${f.id}-hint`}>{f.hint}</p>}
            <div class="checks">
              {f.options!.map((o) => <label class="check"><input type="checkbox" name={f.id} value={o} /><span>{o}</span></label>)}
            </div>
          </fieldset>
        );
        if (f.type === 'checkbox') return (
          <div class="field field--wide field--single">
            <label class="check"><input type="checkbox" id={f.id} name={f.id} required={f.required} /><span>{f.label} {mark}</span></label>
          </div>
        );
        return (
          <div class:list={['field', wide(f) && 'field--wide']}>
            <label class="field__label" for={f.id}>{f.label} {mark}</label>
            {f.type === 'select' && (
              <select class="input" id={f.id} name={f.id} required={f.required}>
                <option value=""></option>
                {f.options!.map((o) => <option>{o}</option>)}
              </select>
            )}
            {f.type === 'textarea' && (
              <>
                <textarea class="input" id={f.id} name={f.id} maxlength={f.maxLength} required={f.required} rows="6" aria-describedby={`${f.id}-count`}></textarea>
                <p class="note field__count" id={`${f.id}-count`} data-count-for={f.id}><span data-left>{f.maxLength}</span> {ui.charactersLeft}</p>
              </>
            )}
            {['text', 'email', 'url'].includes(f.type) && (
              <input class="input" type={f.type} id={f.id} name={f.id} required={f.required}
                autocomplete={f.id === 'name' ? 'name' : f.id === 'email' ? 'email' : f.id === 'country' ? 'country-name' : f.id === 'city' ? 'address-level2' : f.id === 'state' ? 'address-level1' : 'off'} />
            )}
          </div>
        );
      })}
      <div class="form__send ruled ruled--strong ruled--end">
        <button class="cta cta--cell cta--row" type="submit" style="width:100%"><span>{form.submit}</span><Icon name="play" size={22} /></button>
      </div>
    </form>
  </Section>
</Layout>

<style is:global>
  .form__intro { margin-bottom: 64px; }
  .field--single + .field--single { margin-top: -24px; }
  @media (max-width: 809.98px) { .form__intro { margin-bottom: 44px; } }
</style>
