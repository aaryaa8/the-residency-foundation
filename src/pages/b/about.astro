---
import Layout from '../../directions/b/Layout.astro';
import Hero from '../../directions/b/Hero.astro';
import Section from '../../directions/b/Section.astro';
import Icon from '../../base/Icon.astro';
import { about } from '../../content/site';

const n = (i: number) => String(i + 1).padStart(2, '0');
const g = about.governance;
---
<Layout title={about.label} current="about">
  <Hero heading={about.heading} label={about.label} size="m" wide plate={{ name: 'odyssey', alt: 'Placeholder image: a statue of a helmeted figure, seen from behind.', ratio: '4 / 5', pos: '72% 100%' }}>
    <p class="hero__lead lead" data-reveal style="--i:4">{about.body}</p>
  </Hero>

  <Section label={g.label} id="governance">
    <h2 class="h2 sec__h at-2-5 t-wide" data-reveal>{g.heading}</h2>
    <ul class="rows">
      {g.items.map((item, i, all) => (
        <li class:list={['row ruled', i === all.length - 1 && 'ruled--end']} style={`--i:${i}`}>
          <span class="num row__n" aria-hidden="true">{n(i)}</span>
          <h3 class="label row__k">{item.label}</h3>
          <p class="row__t">{item.text}</p>
        </li>
      ))}
    </ul>
    <p class="statement at-2-5 cellpad about__status" data-reveal>{g.status}</p>
  </Section>

  <section class="sec" id="board">
    <div class="sec__in">
      <span class="rule rule--strong" data-draw></span>
      <details class="board ruled--end ruled">
        <summary>
          <h2 class="label"><Icon name="marker" />{about.board.label}</h2>
          <span class="qa__x" aria-hidden="true"></span>
        </summary>
        <ul class="board__list">
          {about.board.people.map((person) => (
            <li>
              <p class="board__name">{person.name}</p>
              <p class="board__role">{person.role}</p>
            </li>
          ))}
        </ul>
      </details>
    </div>
  </section>

  <Section label={about.contact.label} labelTag="h2" id="contact">
    <ul class="contact__list cellpad">
      {about.contact.emails.map((e) => (
        <li class="statement"><a class="link" href={`mailto:${e}`}>{e}</a></li>
      ))}
    </ul>
  </Section>
</Layout>

<style is:global>
  .about__status { margin-top: 72px; }
  #board .sec__in { padding-bottom: calc(var(--sec-gap) * 0.6); }
  #board .board::before { display: none; }
  .contact__list { padding-top: 24px; }
  @media (max-width: 809.98px) { .about__status { margin-top: 44px; } .contact__list { padding-top: 12px; } }
</style>
