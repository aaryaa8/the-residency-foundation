---
import Layout from '../../directions/b/Layout.astro';
import Hero from '../../directions/b/Hero.astro';
import Section from '../../directions/b/Section.astro';
import Icon from '../../base/Icon.astro';
import { donate, org, ui } from '../../content/site';

const n = (i: number) => String(i + 1).padStart(2, '0');
---
<Layout title={donate.label} current="donate">
  <Hero heading={donate.heading} label={donate.label} size="l" plate={{ name: 'atlas', alt: 'Placeholder image: a statue of Atlas holding up an atom.', ratio: '4 / 5' }}>
    <p class="hero__sub hero__sub--plain" data-reveal style="--i:4">{donate.body[0]}</p>
    <div class="hero__body" data-reveal style="--i:5"><p>{donate.body[1]}</p></div>
  </Hero>

  <Section label={donate.levelsLabel} labelTag="h2" id="give">
    <p class="statement statement--xl sec__h at-2-5 t-wide" data-reveal>{donate.money}</p>
    <ul class="rows levels">
      {donate.levels.map((level, i, all) => (
        <li class:list={['row ruled', i === all.length - 1 && 'ruled--end']} style={`--i:${i}`}>
          <span class="num row__n" aria-hidden="true">{n(i)}</span>
          <div class="row__t">
            <h3>{level.label}</h3>
            <p>{level.text}</p>
          </div>
          <p class="amount">{level.amount}</p>
        </li>
      ))}
    </ul>

    <div class="ruled ruled--strong ruled--end at-2-4 give">
      <a class="cta cta--cell cta--row" href={donate.button.href} target="_blank" rel="noopener">
        <span>{donate.button.label}<span class="visually-hidden"> ({ui.newTab})</span></span><Icon name="play" size={22} />
      </a>
    </div>
    <p class="note at-5-6 give give__note" data-reveal>{donate.buttonNote}</p>
    <p class="small at-2-4 give__disc" data-reveal>{donate.disclosure}</p>

    <div class="pair at-2-5 t-wide">
      <p class="ruled ruled--end"><span>{donate.deductible}</span></p>
      <p class="ruled ruled--end" style="--i:1"><span>{donate.larger} <a class="link link--set" href={`mailto:${org.majorGiftsEmail}`}>{org.majorGiftsEmail}</a>.</span></p>
    </div>
  </Section>
</Layout>
