---
import Layout from '../site/Layout.astro';
import Hero from '../site/Hero.astro';
import Section from '../site/Section.astro';
import Donate from '../site/Donate.astro';
import { donate, org } from '../content/site';
import { tidy } from '../site/text';
---
<Layout title={donate.label} current="donate" motion="a">
  <Hero heading={donate.heading} wide plate={{ name: 'atlas' }}>
    <div class="actions">
      <Donate label={donate.button.label} href={donate.button.href} />
    </div>
    <div class="hero__note small">
      <p>{tidy(donate.buttonNote)}</p>
      <p>{tidy(donate.disclosure)}</p>
    </div>
    <div class="hero__body text">{donate.body.map((t) => <p>{tidy(t)}</p>)}</div>
  </Hero>

  <Section title={donate.levelsLabel} id="ways-to-give" rule flush>
    <p class="statement" data-rise>{tidy(donate.money)}</p>
    <ul class="levels flush" role="list">
      {donate.levels.map((level, i, all) => (
        <li class:list={['level ruled', i === all.length - 1 && 'ruled--end']} data-rise style={`--d:${i * 40}ms`}>
          <div class="level__t">
            <h3>{level.label}</h3>
            <p>{tidy(level.text)}</p>
          </div>
          <p class="level__a">{level.amount}</p>
        </li>
      ))}
    </ul>
    <div class="stack gap-40 lead" data-rise>
      <p>{tidy(donate.designate)}</p>
      <p>{tidy(donate.deductible)}</p>
      <p>{donate.larger} <a class="link link--set" href={`mailto:${org.majorGiftsEmail}`}>{org.majorGiftsEmail}</a>.</p>
    </div>
  </Section>
</Layout>
