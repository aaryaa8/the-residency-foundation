---
import Layout from '../../directions/a/Layout.astro';
import PageHero from '../../directions/a/PageHero.astro';
import Section from '../../directions/a/Section.astro';
import Cta from '../../directions/a/Cta.astro';
import { donate, home, org, shown } from '../../content/site';
import { nb } from '../../directions/a/text';

const levels = donate.levels.filter((l) => shown(l.key));
---
<Layout title={donate.label} current="donate">
  <PageHero label={donate.label} heading={donate.heading} size="lg" capL="-0.06em" capR="-0.02em"
    door={{ statue: 'atlas', imgW: '138%' }}>
    <div class="lead measure stack">{donate.body.map((p) => <p>{p}</p>)}</div>
  </PageHero>

  <Section label={donate.levelsLabel} class="ways">
    <p class="statement ways__money" data-rise>{donate.money}</p>
    <dl class="rows levels">
      {levels.map((l, i) => (
        <div data-rise style={`--d:${i * 80}ms`}>
          <dt class="label">{l.label}</dt>
          <dd class="levels__text">{l.text}</dd>
          <dd class="levels__amount">{l.amount}</dd>
        </div>
      ))}
    </dl>
  </Section>

  <Section label={home.give.label} heading={donate.when} class="ask">
    <p class="lead measure" data-rise>{donate.deductible}</p>
    <div class="ask__cta measure" data-rise>
      <Cta href={donate.button.href} label={donate.button.label} size="bar" external />
      <p class="small">{donate.buttonNote}</p>
      <p class="small" set:html={nb(donate.disclosure)} />
    </div>
    <p class="ask__larger measure" data-rise>{donate.larger} <a class="link" href={`mailto:${org.majorGiftsEmail}`}>{org.majorGiftsEmail}</a>.</p>
  </Section>
</Layout>
