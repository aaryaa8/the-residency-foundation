---
import Layout from '../../directions/a/Layout.astro';
import PageHero from '../../directions/a/PageHero.astro';
import Section from '../../directions/a/Section.astro';
import { asset } from '../../base/url';
import { about } from '../../content/site';
import { nb, email } from '../../directions/a/text';
---
<Layout title={about.label} current="about">
  <PageHero label={about.label} heading={about.heading} size="md" capL="-0.08em" capR="-0.05em">
    <p class="about__body measure">{about.body}</p>
  </PageHero>

  <Section label={about.governance.label} heading={about.governance.heading} class="gov">
    <dl class="rows pairs">
      {about.governance.items.map((it, i) => (
        <div data-rise style={`--d:${i * 70}ms`}><dt class="label">{it.label}</dt><dd>{it.text}</dd></div>
      ))}
    </dl>
    <p class="lead gov__status" data-rise set:html={nb(about.governance.status)} />
    <figure slot="after" class="plinth plinth--fit" data-rise>
      <img src={asset('img/placeholder/vienna-gold.webp')} alt="" width="1600" height="1600" data-placeholder="true" loading="lazy" decoding="async" />
    </figure>
  </Section>

  <section class="sec board">
    <div class="wrap g6 sec__grid">
      <div class="sec__body">
        <details class="qa">
          <summary><h2 class="qa__q">{about.board.label}</h2><span class="qa__icon" aria-hidden="true"></span></summary>
          <div class="qa__a">
            <ul class="rows people">
              {about.board.people.map((p) => (
                <li><p class="people__name">{p.name}</p><p class="people__role">{p.role}</p></li>
              ))}
            </ul>
          </div>
        </details>
      </div>
    </div>
  </section>

  <Section label={about.contact.label} class="contact sec--tight">
    <ul class="contact__list" data-rise>
      {about.contact.emails.map((e) => <li><a class="link link--quiet" href={`mailto:${e}`} set:html={email(e)} /></li>)}
    </ul>
  </Section>
</Layout>
