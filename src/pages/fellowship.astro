---
import Layout from '../site/Layout.astro';
import Hero from '../site/Hero.astro';
import Section from '../site/Section.astro';
import Req from '../site/Req.astro';
import Icon from '../base/Icon.astro';
import { fellowship, home, ui, forms } from '../content/site';
import { link } from '../base/url';
import { tidy } from '../site/text';

const form = fellowship.form;
type Field = { id: string; label: string; type: string; required: boolean; options?: string[]; hint?: string; maxLength?: number };
const fields = form.fields as Field[];
const wide = (f: Field) => ['textarea', 'checkboxes', 'checkbox'].includes(f.type);
const auto: Record<string, string> = { name: 'name', email: 'email', country: 'country-name', state: 'address-level1', city: 'address-level2', link: 'url' };
---
<Layout title={fellowship.label} current="fellowship" motion="a">
  <Hero heading={fellowship.heading} plate={{ name: 'vienna', pos: '100% 100%' }}>
    <p class="hero__sub statement">{tidy(fellowship.intro)}</p>
  </Hero>

  <section class="sec sec--move sec--flush" id="fellowship">
    <div class="sec__in">
      <span class="rule rule--strong" data-draw></span>
      <div class="facts">
        {fellowship.sections.map((s) => (
          <div class="facts__row ruled" data-rise>
            <h2 class="sec__title sec__title--s">{s.title}</h2>
            <p class="lead">{tidy(s.text)}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <Section title={home.tracks.title} id="tracks" rule>
    <div class="prose lead" data-rise>{home.tracks.intro.map((t) => <p>{tidy(t)}</p>)}</div>
    <ul class="names sec__wide" slot="wide" role="list">
      {home.tracks.names.map((n, i) => <li class="key" data-rise style={`--d:${i * 30}ms`}>{n}</li>)}
    </ul>
  </Section>

  <Section title={form.title} id="interest" rule>
    <p class="lead" data-rise>{tidy(form.intro)}</p>
    <form class="form full flush" data-form="interest" data-thanks={form.thanks} data-endpoint={forms.endpoint} data-sending={forms.sending}>
      <p class="small form__note">{ui.requiredNote} {forms.privacyNote} <a class="link link--set" href={link(forms.privacyLink.slug)}>{forms.privacyLink.label}</a>.</p>
      <div class="hp" aria-hidden="true"><label>website <input type="text" name="website" tabindex="-1" autocomplete="off" /></label></div>
      {fields.map((f) => {
        const mark = f.required ? <Req /> : <span class="field__opt">({ui.optional})</span>;
        if (f.type === 'checkboxes') return (
          <fieldset class="field field--wide" aria-describedby={f.hint ? `${f.id}-hint` : undefined}>
            <legend>{f.label} {mark}</legend>
            {f.hint && <p class="field__hint" id={`${f.id}-hint`}>{f.hint}</p>}
            <div class="checks">
              {f.options!.map((o) => <label class="check"><input type="checkbox" name={f.id} value={o} /><span>{o}</span></label>)}
            </div>
          </fieldset>
        );
        if (f.type === 'checkbox') return (
          <div class="field field--wide field--single">
            <label class="check"><input type="checkbox" id={f.id} name={f.id} required={f.required} /><span>{f.label} {mark}</span></label>
          </div>
        );
        // A link is a plain text field with a hint, so "github.com/ada" is not turned away.
        const hint = f.type === 'url' ? ui.linkHint : f.hint;
        const described = hint ? `${f.id}-hint` : undefined;
        return (
          <div class:list={['field', wide(f) && 'field--wide']}>
            <label class="field__label" for={f.id}>{f.label} {mark}</label>
            {hint && <p class="field__hint" id={`${f.id}-hint`}>{hint}</p>}
            {f.type === 'select' && (
              <select class="input" id={f.id} name={f.id} required={f.required}>
                <option value="">{ui.chooseOne}</option>
                {f.options!.map((o) => <option>{o}</option>)}
              </select>
            )}
            {f.type === 'textarea' && (
              <>
                <textarea class="input" id={f.id} name={f.id} maxlength={f.maxLength} required={f.required} rows="6" aria-describedby={described}></textarea>
                <p class="small field__count" data-count-for={f.id} data-unit={ui.charactersLeft}><span data-left>{f.maxLength}</span> {ui.charactersLeft}</p>
                <p class="visually-hidden" role="status" data-count-status={f.id}></p>
              </>
            )}
            {f.type === 'url' && (
              <input class="input" type="text" inputmode="url" id={f.id} name={f.id} required={f.required} autocomplete={auto[f.id] ?? 'off'} aria-describedby={described} />
            )}
            {['text', 'email'].includes(f.type) && (
              <input class="input" type={f.type} id={f.id} name={f.id} required={f.required} autocomplete={auto[f.id] ?? 'off'} aria-describedby={described} />
            )}
          </div>
        );
      })}
      <p class="form__error" role="alert" tabindex="-1" data-form-error hidden>{forms.failed}</p>
      <button class="cta cta--cell ruled ruled--end form__send" type="submit"><span>{form.submit}</span><Icon name="play" /></button>
    </form>
  </Section>
</Layout>
